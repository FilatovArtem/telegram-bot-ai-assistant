# =============================================================================
# Telegram Bot AI Assistant — environment configuration
# Copy to .env and fill all required values. Never commit your real .env.
# Details: docs/setup/01-tokens-and-keys.md
# =============================================================================

# --- Telegram (required) ---
# Bot API token from @BotFather (https://t.me/BotFather → /newbot)
BOT_TOKEN=
# CSV of Telegram user IDs allowed in /admin. Get yours from @userinfobot.
ADMIN_IDS=
# Chat ID for operator hand-off. 0 disables hand-off.
# For private groups format is negative (e.g. -1001234567890).
ADMIN_CHAT_ID=0

# --- REST API (required) ---
# Shared secret for the X-Api-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ADMIN_TOKEN=
API_PORT=8000

# --- LLM + Embeddings (required) ---
# Default: OpenAI. Tested alternatives: Groq (chat), Ollama (embed + chat),
# DeepSeek, Together, OpenRouter — see docs/setup/01-tokens-and-keys.md §6.
#
# All providers below are OpenAI-compatible — only base_url + model + key
# change. embedding_api_key / embedding_base_url override the embed endpoint
# separately, so chat and embeddings can use different providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=6
# Embedding dimensionality — MUST match the embedding model:
#   text-embedding-3-small  → 1536
#   text-embedding-3-large  → 3072
#   nomic-embed-text (Ollama) → 768
#   bge-large-en-v1.5       → 1024
EMBEDDING_DIM=1536

# --- Optional: free / self-hosted alternatives (OpenAI-compatible) ---
#
# Example A: Groq for chat (free, 30 RPM, no card) + Ollama for embeddings:
#   OPENAI_API_KEY=gsk_...                   # from console.groq.com/keys
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#   EMBEDDING_API_KEY=ollama                 # dummy, Ollama ignores it
#   EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIM=768
#
# Example B: DeepSeek (chat — $5 free trial credit, then $0.14/1M):
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-chat
#   (DeepSeek has no public embeddings — use Ollama or OpenAI for that)
#
# Example C: Fully self-hosted via Ollama (chat + embed, zero cost forever,
# but chat is slow on CPU. Llama 8B ≈ 1-3 tok/s on this server).
OPENAI_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Database ---
# Default SQLite is fine for MVP. For PostgreSQL use:
#   postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# --- RAG pipeline ---
RELEVANCE_THRESHOLD=0.75
RELEVANCE_MIN_GAP=0.05
BM25_ENABLED=true
RERANK_ENABLED=false
TOP_K_DENSE=50
TOP_K_BM25=50
TOP_K_FINAL=10
RRF_K=60
MAX_CHUNK_TOKENS=500
CHUNK_OVERLAP=100

# --- Upload limits ---
MAX_UPLOAD_BYTES=10485760
MAX_CHUNKS_PER_DOC=5000
THROTTLE_PER_USER_PER_SEC=1.0

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
# Sentry DSN (optional). Create a Python/FastAPI project on sentry.io.
SENTRY_DSN=
METRICS_INTERNAL_ONLY=false
ENVIRONMENT=production

# --- Bootstrap ---
# Seed data/knowledge/sample_faq.md on first run if the index is empty.
SEED_SAMPLE_ON_FIRST_RUN=true

# --- Outbound proxy (optional) -----------------------------------------------
# Set if the host network blocks Telegram / OpenAI directly (e.g. behind
# corporate firewall or in a region where these are blocked).
#
# Inside the docker-compose container, `host.docker.internal` resolves to the
# Docker host (Linux: via extra_hosts host-gateway, already configured).
# Typical value when running xray HTTP-proxy on host 127.0.0.1:10808:
#
#   TELEGRAM_PROXY=http://host.docker.internal:10808
#   HTTPS_PROXY=http://host.docker.internal:10808
#   HTTP_PROXY=http://host.docker.internal:10808
#   NO_PROXY=localhost,127.0.0.1
#
# Outside Docker (bare metal), use 127.0.0.1:10808 directly.
TELEGRAM_PROXY=
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1
